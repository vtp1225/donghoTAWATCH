Enum import_receipt_status_enum {
  DRAFT
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

Enum order_payment_method_enum {
  BANK_TRANSFER
  COD
  MOMO
  VNPAY
}

Enum order_payment_status_enum {
  FAILED
  PAID
  PENDING
  REFUNDED
  UNPAID
}

Enum otp_verification_purpose_enum {
  CHANGE_EMAIL
  RESET_PASSWORD
  VERIFY_EMAIL
}

Enum payment_transaction_gateway_enum {
  BANK_TRANSFER
  COD
  VNPAY
}

Enum promotion_promo_type_enum {
  PRODUCT
  ORDER
  CATEGORY
  BRAND
}

Enum promotion_discount_type_enum {
  PERCENT
  FIXED_AMOUNT
}

Enum return_request_status_enum {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

Enum return_request_refund_method_enum {
  COD_REFUND
  VNPAY_REFUND
  STORE_CREDIT
}

Enum segment_delivery_method_enum {
  EXTERNAL_SHIPPER
  DIRECT_SHOP
}

Enum user_auth_provider_enum {
  LOCAL
  GOOGLE
}

Enum user_role_enum {
  CUSTOMER
  ADMIN
  STAFF
}

Enum watch_movement_type_enum {
  AUTOMATIC
  MANUAL
  QUARTZ
  SOLAR
  SMART
}

Enum watch_glass_material_enum {
  ACRYLIC
  HARDLEX
  MINERAL
  SAPPHIRE
  SAPPHIRE_COATED
}

Enum watch_variant_strap_material_enum {
  CERAMIC
  GOLD
  LEATHER
  MESH
  NYLON
  RUBBER
  STAINLESS_STEEL
  TITANIUM
}

Table admin_log {
  id int [pk, not null, increment]
  admin_id int [not null]
  action varchar(100) [not null, note: 'CREATE | UPDATE | DELETE | APPROVE...']
  table_name varchar(100) [not null]
  record_id int
  old_value json [note: 'Giá trị trước khi thay đổi']
  new_value json [note: 'Giá trị sau khi thay đổi']
  ip_address varchar(45)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (admin_id, created_at) [name: 'idx_admin_log_admin']
  }
}

Table brand {
  id int [pk, not null, increment]
  name varchar(100) [not null]
  country varchar(100)
  description tinytext
  logo_url varchar(500)
  is_active tinyint(1) [not null, default: '1']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  slug varchar(150)

  Indexes {
    slug [unique, name: 'uk_brand_slug']
  }
}

Table cart {
  id int [pk, not null, increment]
  user_id int [note: 'NULL nếu là guest']
  session_id varchar(128) [note: 'Session ID cho guest']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    user_id [name: 'fk_cart_user']
    session_id [name: 'idx_cart_session']
  }
}

Table cart_item {
  id int [pk, not null, increment]
  cart_id int [not null]
  watch_variant_id int [not null]
  quantity int [not null, default: '1']
  unit_price decimal(15,0) [not null, note: 'Giá tại thời điểm thêm vào giỏ']

  Indexes {
    cart_id [name: 'fk_ci_cart']
    watch_variant_id [name: 'fk_ci_variant']
  }
}

Table category {
  id int [pk, not null, increment]
  name varchar(150) [not null]
  slug varchar(200) [not null]
  parent_id int

  Indexes {
    slug [unique, name: 'slug']
    parent_id [name: 'fk_cat_parent']
  }
}

Table color {
  id int [pk, not null, increment]
  name varchar(80) [not null]
  hex_code varchar(10) [note: 'Mã màu HEX, ví dụ #000000']
  is_active tinyint(1) [not null, default: '1']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    name [unique, name: 'name']
    name [unique, name: 'uk_color_name']
  }
}

Table coupon {
  id int [pk, not null, increment]
  promotion_id int [not null]
  code varchar(50) [not null]
  user_id int [note: 'NULL = dùng chung, có giá trị = riêng user đó']
  is_used tinyint(1) [not null, default: '0']
  used_at timestamp
  expires_at datetime

  Indexes {
    code [unique, name: 'code']
    promotion_id [name: 'fk_cp_promotion']
    user_id [name: 'fk_cp_user']
    code [name: 'idx_coupon_code']
  }
}

Table import_receipt {
  id int [pk, not null, increment]
  receipt_code varchar(30) [not null]
  supplier_id int [not null]
  created_by int [not null, note: 'admin/staff tạo phiếu']
  total_amount decimal(15,0) [not null, default: '0']
  status import_receipt_status_enum [not null]
  note tinytext
  import_date date [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    receipt_code [unique, name: 'receipt_code']
    created_by [name: 'fk_ir_creator']
    supplier_id [name: 'idx_import_supplier']
  }
}

Table import_receipt_item {
  id int [pk, not null, increment]
  receipt_id int [not null]
  watch_variant_id int [not null]
  quantity int [not null]
  unit_cost decimal(15,0) [not null, note: 'Giá nhập / đơn vị']
  total_cost decimal(15,0) [not null, note: 'quantity × unit_cost']
  batch_number varchar(50) [note: 'Số lô hàng']
  expiry_date date [note: 'Hạn bảo hành / hạn dùng nếu có']

  Indexes {
    receipt_id [name: 'fk_iri_receipt']
    watch_variant_id [name: 'fk_iri_variant']
  }
}

Table order {
  id int [pk, not null, increment]
  order_code varchar(30) [not null]
  user_id int [note: 'NULL nếu guest']
  guest_email varchar(150) [note: 'Dùng khi guest đặt hàng']
  guest_phone varchar(20)
  guest_name varchar(200)
  address_id int [note: 'Địa chỉ đã lưu (nếu có TK)']
  shipping_address_snapshot tinytext [not null]
  subtotal decimal(15,0) [not null]
  discount_amount decimal(15,0) [not null, default: '0']
  shipping_fee decimal(15,0) [not null, default: '0']
  total_amount decimal(15,0) [not null]
  coupon_id int
  payment_method order_payment_method_enum [not null]
  payment_status order_payment_status_enum [not null, default: 'PENDING']
  order_status varchar(50) [not null]
  delivery_method varchar(50) [not null]
  tracking_code varchar(100) [note: 'Mã vận đơn GHTK/GHN']
  shipper_id int [note: 'Đơn vị giao hàng bên ngoài']
  note tinytext
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    order_code [unique, name: 'order_code']
    address_id [name: 'fk_ord_address']
    coupon_id [name: 'fk_ord_coupon']
    shipper_id [name: 'fk_ord_shipper']
    user_id [name: 'idx_order_user']
    order_status [name: 'idx_order_status']
    created_at [name: 'idx_order_created']
  }
}

Table order_item {
  id int [pk, not null, increment]
  order_id int [not null]
  watch_variant_id int [not null]
  product_snapshot json [not null, note: 'Snapshot: tên, ảnh, màu, size tại thời điểm mua']
  quantity int [not null]
  unit_price decimal(15,0) [not null]
  total_price decimal(15,0) [not null]

  Indexes {
    order_id [name: 'fk_oi_order']
    watch_variant_id [name: 'fk_oi_variant']
  }
}

Table order_status_history {
  id int [pk, not null, increment]
  order_id int [not null]
  status varchar(50) [not null]
  note varchar(500)
  changed_by int [note: 'user.id của admin/staff thực hiện']
  changed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    order_id [name: 'fk_osh_order']
    changed_by [name: 'fk_osh_user']
  }
}

Table otp_verification {
  id int [pk, not null, increment]
  email varchar(150) [not null]
  otp_code varchar(10) [not null, note: 'Mã OTP 6 số']
  purpose otp_verification_purpose_enum [not null]
  is_used tinyint(1) [not null, default: '0']
  attempts tinyint [not null, default: '0', note: 'Số lần nhập sai, tối đa 5']
  expires_at datetime [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    email [name: 'idx_otp_email']
    expires_at [name: 'idx_otp_expires']
  }
}

Table payment_transaction {
  id int [pk, not null, increment]
  order_id int [not null]
  transaction_code varchar(100) [note: 'Mã giao dịch từ cổng thanh toán']
  gateway payment_transaction_gateway_enum [not null]
  amount decimal(15,0) [not null]
  status varchar(50) [not null, default: 'PENDING']
  response_data json [note: 'Raw response từ VNPay IPN']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    transaction_code [unique, name: 'transaction_code']
    order_id [name: 'fk_pt_order']
  }
}

Table promotion {
  id int [pk, not null, increment]
  name varchar(255) [not null]
  promo_type promotion_promo_type_enum [not null]
  discount_type promotion_discount_type_enum [not null]
  discount_value decimal(10,2) [not null]
  min_order_value decimal(15,0) [not null, default: '0']
  max_discount_amount decimal(15,0) [note: 'Giảm tối đa (cho loại PERCENT)']
  max_uses int [note: 'Tổng lượt dùng tối đa']
  used_count int [not null, default: '0']
  min_purchase_count int [not null, default: '0', note: 'Số lần mua tối thiểu (loyalty)']
  watch_variant_id int [note: 'Áp dụng riêng biến thể (slow-moving)']
  applies_to_all tinyint(1) [not null, default: '1', note: 'Áp dụng toàn đơn']
  start_date datetime [not null]
  end_date datetime [not null]
  is_active tinyint(1) [not null, default: '1']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  watch_id int

  Indexes {
    watch_variant_id [name: 'fk_promo_variant']
    (start_date, end_date) [name: 'idx_promotion_dates']
    watch_id [name: 'FKek1e7tkku4q1yty54sq9r7dmr']
  }
}

Table promotion_watch {
  promotion_id int [not null]
  watch_id int [not null]

  Indexes {
    (promotion_id, watch_id) [pk]
    watch_id [name: 'FK7by54h6ayhs00ycnn4lp6ftn4']
  }
}

Table refresh_token {
  id int [pk, not null, increment]
  user_id int [not null]
  token_hash varchar(255) [not null, note: 'SHA-256 của token thực']
  device_info varchar(255) [note: 'User-Agent / tên thiết bị']
  ip_address varchar(45)
  is_revoked tinyint(1) [not null, default: '0']
  expires_at datetime [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  last_used_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    token_hash [unique, name: 'token_hash']
    user_id [name: 'idx_rt_user']
    expires_at [name: 'idx_rt_expires']
  }
}

Table return_item {
  id int [pk, not null, increment]
  return_id int [not null]
  order_item_id int [not null]
  quantity int [not null]
  condition_note tinytext

  Indexes {
    return_id [name: 'fk_ri_return']
    order_item_id [name: 'fk_ri_orderitem']
  }
}

Table return_request {
  id int [pk, not null, increment]
  order_id int [not null]
  user_id int [not null]
  reason tinytext [not null]
  status return_request_status_enum [not null, default: 'PENDING']
  refund_method return_request_refund_method_enum
  refund_amount decimal(15,0)
  admin_note tinytext
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    order_id [name: 'fk_rr_order']
    user_id [name: 'fk_rr_user']
  }
}

Table review {
  id int [pk, not null, increment]
  user_id int [not null]
  watch_id int [not null]
  order_id int [not null, note: 'Chỉ review sau khi đã mua']
  rating tinyint [not null, note: 'Rating 1-5']
  comment tinytext
  is_approved tinyint(1) [not null, default: '0', note: 'Admin duyệt trước khi hiển thị']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]


  Indexes {
    (user_id, watch_id, order_id) [unique, name: 'uq_review']
    order_id [name: 'fk_rv_order']
    watch_id [name: 'idx_review_watch']
  }
}

Table segment {
  id int [pk, not null, increment]
  name varchar(100) [not null]
  delivery_method segment_delivery_method_enum [not null, default: 'EXTERNAL_SHIPPER']
  slug varchar(120)

  Indexes {
    slug [unique, name: 'uk_segment_slug']
  }
}

Table shipper {
  id int [pk, not null, increment]
  name varchar(100) [not null]
  api_endpoint varchar(500)
  api_key varchar(500)
  is_active tinyint(1) [not null, default: '1']
}

Table store_settings {
  id bigint [pk, not null]
  address varchar(500)
  default_shipping_fee decimal(15,0)
  free_shipping_threshold decimal(15,0)
  phone varchar(50)
  store_name varchar(200)
  support_email varchar(200)
  website varchar(200)
}

Table supplier {
  id int [pk, not null, increment]
  name varchar(200) [not null]
  email varchar(150) [not null]
  phone varchar(20) [not null]
  address tinytext
  is_active tinyint(1) [not null, default: '1']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table supplier_brand {
  supplier_id int [not null]
  brand_id int [not null]

  Indexes {
    (supplier_id, brand_id) [pk]
    brand_id [name: 'fk_sb_brand']
  }
}

Table user {
  id int [pk, not null, increment]
  username varchar(80)
  email varchar(150) [not null]
  password_hash varchar(255) [note: 'NULL nếu đăng nhập Google']
  full_name varchar(200)
  phone varchar(20)
  birthday date
  auth_provider user_auth_provider_enum [not null, default: 'LOCAL']
  google_id varchar(200) [note: 'Sub từ Google OAuth']
  role user_role_enum [not null, default: 'CUSTOMER']
  loyalty_points int [not null, default: '0']
  is_active tinyint(1) [not null, default: '1']
  is_verified tinyint(1) [not null, default: '0', note: 'Email đã xác thực OTP chưa']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    email [unique, name: 'email']
    username [unique, name: 'username']
    google_id [unique, name: 'google_id']
  }
}

Table user_address {
  id int [pk, not null, increment]
  user_id int [not null]
  recipient_name varchar(200) [not null]
  phone varchar(20) [not null]
  address_detail tinytext [not null]
  province varchar(100) [not null]
  district varchar(100) [not null]
  ward varchar(100) [not null]
  is_default tinyint(1) [not null, default: '0']
  ghn_district_id int
  ghn_ward_code varchar(20)

  Indexes {
    user_id [name: 'fk_ua_user']
  }
}

Table watch {
  id int [pk, not null, increment]
  sku varchar(50) [not null]
  name varchar(255) [not null]
  brand_id int [not null]
  category_id int [not null]
  segment_id int [not null]
  description tinytext
  movement_type watch_movement_type_enum [not null]
  glass_material watch_glass_material_enum
  thickness_mm decimal(5,2) [note: 'Độ dày (mm)']
  water_resistance_atm decimal(5,1) [note: 'Chống nước (ATM)']
  power_reserve_hours int [note: 'Khoảng trữ cót (giờ)']
  battery_type varchar(50) [note: 'Loại pin nếu là quartz']
  features tinytext
  is_active tinyint(1) [not null, default: '1']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  slug varchar(255)
  is_featured bit(1) [not null, default: '0']

  Indexes {
    sku [unique, name: 'sku']
    slug [unique, name: 'uk_watch_slug']
    brand_id [name: 'idx_watch_brand']
    segment_id [name: 'idx_watch_segment']
    category_id [name: 'idx_watch_category']
  }
}

Table watch_image {
  id int [pk, not null, increment]
  alt_text varchar(255)
  is_primary bit(1) [not null, default: '0']
  sort_order int [not null, default: '0']
  url varchar(500) [not null]
  watch_id int [not null]

  Indexes {
    watch_id [name: 'FKfoulfuqmvuh3yjpquebcp2b71']
  }
}

Table watch_variant {
  id int [pk, not null, increment]
  watch_id int [not null]
  dial_color_id int [note: 'Màu mặt số']
  dial_color varchar(80) [note: 'Màu mặt số']
  strap_color_id int [note: 'Màu dây']
  strap_color varchar(80) [note: 'Màu dây']
  strap_material watch_variant_strap_material_enum
  case_size_mm decimal(5,2) [note: 'Kích thước mặt (mm)']
  price decimal(15,0) [not null]
  image_url varchar(500) [note: 'Ảnh đại diện biến thể']
  stock_quantity int [not null, default: '0']
  is_active tinyint(1) [not null, default: '1']

  Indexes {
    watch_id [name: 'idx_watch_variant']
    dial_color_id [name: 'idx_wv_dial_color']
    strap_color_id [name: 'idx_wv_strap_color']
  }
}

Table watch_variant_image {
  id int [pk, not null, increment]
  variant_id int [not null]
  url varchar(500) [not null]
  alt_text varchar(255)
  is_primary tinyint(1) [not null, default: '0', note: 'Ảnh đại diện của biến thể này']
  is_main_image tinyint(1) [not null, default: '0', note: 'Ảnh đại diện hiển thị chung cho toàn sản phẩm']
  sort_order int [not null, default: '0']
  public_id varchar(255)

  Indexes {
    variant_id [name: 'fk_wvi_variant']
    variant_id [name: 'idx_wvi_variant_id']
    is_main_image [name: 'idx_wvi_is_main_image']
  }
}

Table wishlist {
  id int [pk, not null, increment]
  user_id int [not null]
  watch_variant_id int [not null]
  added_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  Indexes {
    (user_id, watch_variant_id) [unique, name: 'uq_wishlist']
    watch_variant_id [name: 'fk_wl_variant']
  }
}

Ref fk_al_admin:user.id < admin_log.admin_id

Ref fk_cart_user:user.id < cart.user_id [delete: cascade]

Ref fk_ci_cart:cart.id < cart_item.cart_id [delete: cascade]

Ref fk_ci_variant:watch_variant.id < cart_item.watch_variant_id

Ref fk_cat_parent:category.id < category.parent_id [delete: set null]

Ref fk_cp_promotion:promotion.id < coupon.promotion_id

Ref fk_cp_user:user.id < coupon.user_id [delete: set null]

Ref fk_ir_creator:user.id < import_receipt.created_by

Ref fk_ir_supplier:supplier.id < import_receipt.supplier_id

Ref fk_iri_receipt:import_receipt.id < import_receipt_item.receipt_id [delete: cascade]

Ref fk_iri_variant:watch_variant.id < import_receipt_item.watch_variant_id

Ref fk_ord_address:user_address.id < order.address_id [delete: set null]

Ref fk_ord_coupon:coupon.id < order.coupon_id [delete: set null]

Ref fk_ord_shipper:shipper.id < order.shipper_id [delete: set null]

Ref fk_ord_user:user.id < order.user_id [delete: set null]

Ref fk_oi_order:order.id < order_item.order_id [delete: cascade]

Ref fk_oi_variant:watch_variant.id < order_item.watch_variant_id

Ref fk_osh_order:order.id < order_status_history.order_id [delete: cascade]

Ref fk_osh_user:user.id < order_status_history.changed_by [delete: set null]

Ref fk_pt_order:order.id < payment_transaction.order_id [delete: cascade]

Ref fk_promo_variant:watch_variant.id < promotion.watch_variant_id [delete: set null]

Ref FKek1e7tkku4q1yty54sq9r7dmr:watch.id < promotion.watch_id [delete: set null]

Ref FK7by54h6ayhs00ycnn4lp6ftn4:watch.id < promotion_watch.watch_id

Ref FKsksmj5xe9wq107yqnnn443e7i:promotion.id < promotion_watch.promotion_id

Ref fk_rt_user:user.id < refresh_token.user_id [delete: cascade]

Ref fk_ri_orderitem:order_item.id < return_item.order_item_id

Ref fk_ri_return:return_request.id < return_item.return_id [delete: cascade]

Ref fk_rr_order:order.id < return_request.order_id

Ref fk_rr_user:user.id < return_request.user_id

Ref fk_rv_order:order.id < review.order_id

Ref fk_rv_user:user.id < review.user_id

Ref fk_rv_watch:watch.id < review.watch_id

Ref fk_sb_brand:brand.id < supplier_brand.brand_id [delete: cascade]

Ref fk_sb_supplier:supplier.id < supplier_brand.supplier_id [delete: cascade]

Ref fk_ua_user:user.id < user_address.user_id [delete: cascade]

Ref fk_w_brand:brand.id < watch.brand_id

Ref fk_w_category:category.id < watch.category_id

Ref fk_w_segment:segment.id < watch.segment_id

Ref FKfoulfuqmvuh3yjpquebcp2b71:watch.id < watch_image.watch_id [delete: cascade]

Ref fk_wv_dial_color:color.id < watch_variant.dial_color_id [delete: set null]

Ref fk_wv_strap_color:color.id < watch_variant.strap_color_id [delete: set null]

Ref fk_wv_watch:watch.id < watch_variant.watch_id [delete: cascade]

